# Copy of what ./make-env.sh generates. Run ./make-env.sh instead of copying this by hand.
# ---- Lab Tracker settings (edit these two) --------------------------------
DOMAIN=lab.example.com            # the web address that points at this server (tls profile)
COMPANY_NAME=Lab Tracker          # shown in Odoo as the company name
# ---- secrets (random, keep private; never reuse these placeholder values) --
POSTGRES_PASSWORD=change-me-random-hex
REPLICATOR_PASSWORD=change-me-random-hex
DASH_RO_PASSWORD=change-me-random-hex
ADMIN_PASSWORD=change-me-admin-login-password
ODOO_MASTER_PASSWORD=change-me-random-hex
# ---- optional ---------------------------------------------------------------
ODOO_DB=labtracker                # database name
ODOO_BIND=127.0.0.1               # 0.0.0.0 to reach Odoo on port ODOO_PORT without the tls profile
ODOO_PORT=8069
ODOO_CHAT_PORT=8072
WORKERS=2                         # Odoo worker processes (2 is right for 2 GB RAM)
BACKUP_TIME=03:10                 # nightly backup time (server clock)
BACKUP_KEEP_DAYS=14
LAB_CREATE_TEST_USERS=0           # 1 = also create manager@/coordinator@/intern@lab.test
# LAB_TEST_MANAGER_PW=            # passwords for those test users (random + hidden if unset)
# LAB_TEST_COORDINATOR_PW=
# LAB_TEST_INTERN_PW=
# FORCE_PROVISION=0               # 1 = re-run the Lab provisioning on the next start even if unchanged
# LABTRACKER_IMAGE=labtracker-odoo:20.0
