<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="task_form_blocking" model="ir.ui.view">
        <field name="name">Lab task structured blocking</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_form2"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="before">
                <field name="lab_is_blocked" invisible="1"/>
                <div class="alert alert-warning mb-0" invisible="not lab_is_blocked" role="alert">
                    <strong>Blocked by equipment: </strong><field name="lab_block_reason" readonly="1"/>
                </div>
            </xpath>
        </field>
    </record>

    <!-- 20.0.2.2.0: request roll-up of sample time (sample entry fields are provisioned by init/lab_phase2.py) -->
    <record id="task_form_time_total" model="ir.ui.view">
        <field name="name">Lab request total time taken</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_form2"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@id='date_deadline_and_recurring_task']" position="after">
                <field name="lab_time_total" widget="float_time" invisible="parent_id" readonly="1"/>
            </xpath>
        </field>
    </record>
</odoo>
